GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-latest

# --- Steve's HR Department (MCP) ---
# Set to "true" to launch the HR MCP server and give Steve HR tools.
# When unset or not "true", Steve does plain code review (no MCP).
MCP_ENABLED=false

# Optional: the pull request author. Steve uses this name to read/write
# the matching (fictional) HR record. Leave blank if not applicable.
PR_AUTHOR=
